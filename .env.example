# Backend: defaults to this Mac and local Ollama.
ALICE_HOST=127.0.0.1
ALICE_PORT=4317
ALICE_DATA_DIR=data
ALICE_SECRETS_DIR=secrets
ALICE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Put the model API key in secrets/llm-api-key (optional for local Ollama).
# ALICE_LLM_API_KEY=   # optional environment override; never persisted
# Optional backend access token (at least 24 characters).
# If omitted, generated once in secrets/access-token; never logged.
# ALICE_ACCESS_TOKEN=
# Enable HTTP over a trusted LAN only for development.
# Production remote connections should use an HTTPS reverse proxy.
# ALICE_ALLOW_INSECURE_LAN=1
